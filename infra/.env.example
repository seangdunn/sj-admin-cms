# Deploy-time overrides for `cdk deploy` — all optional, sane defaults exist
# in bin/infra.ts. Copy to .env and source it (or export manually) before
# deploying if you need to override any of these, e.g. for a client fork.

TABLE_NAME=portfolio-items
DOMAIN_NAME=sjwebstudio.com
ADMIN_SUBDOMAIN=admin.sjwebstudio.com
# Comma-separated. Defaults to https://<ADMIN_SUBDOMAIN> + localhost:3000 if unset.
ALLOWED_ORIGINS=
